---
import { siteConfig } from "../data/site";

// Swap this once a real Kit.com (ConvertKit) form exists:
// Grow → Landing Pages & Forms → your form → copy the form ID from the embed snippet.
const KIT_FORM_ID = siteConfig.kitFormId;
console.log("Hello", KIT_FORM_ID)
---

<div class="newsletter">
  <form
    class="signup-form"
    action={`https://app.kit.com/forms/${KIT_FORM_ID}/subscriptions`}
    method="post"
  >
    <label class="sr-only" for="email_address">Email address</label>
    <input
      id="email_address"
      name="email_address"
      type="email"
      placeholder="you@example.com"
      required
    />
    <button type="submit">Subscribe</button>
  </form>
  <p class="fine-print">No spam. Unsubscribe anytime.</p>
</div>

<style>
  .signup-form {
    display: flex;
    gap: var(--space-xs);
    max-width: 460px;
  }

  .signup-form input {
    flex: 1;
    padding: 0.85rem 1.1rem;
    border-radius: var(--radius-pill);
    border: 2px solid var(--color-border);
    background: var(--color-bg-elevated);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1rem;
  }

  .signup-form input:focus {
    outline: none;
    border-color: var(--color-accent-2);
  }

  .signup-form button {
    padding: 0.85rem 1.75rem;
    border-radius: var(--radius-pill);
    border: none;
    background: var(--color-accent);
    color: #241900;
    font-family: var(--font-heading);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    box-shadow: 0 4px 0 var(--color-accent-strong);
    cursor: pointer;
    transition: transform 0.12s ease;
  }

  .signup-form button:hover {
    transform: translateY(-2px);
  }

  .fine-print {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    margin-top: var(--space-sm);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  @media (max-width: 480px) {
    .signup-form {
      flex-direction: column;
    }
  }
</style>
