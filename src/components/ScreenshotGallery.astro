---
import { withBase } from "../utils/url";

interface Props {
  images: string[];
  gameTitle: string;
}

const { images, gameTitle } = Astro.props;
---

<div class="gallery">
  {
    images.map((src, i) => (
      <>
        <button
          class="thumb"
          type="button"
          data-dialog-target={`shot-${i}`}
          aria-label={`View screenshot ${i + 1} of ${gameTitle} full size`}
        >
          <img src={withBase(src)} width="1920" height="1080" loading="lazy" alt={`${gameTitle} screenshot ${i + 1}`} />
        </button>
        <dialog id={`shot-${i}`} class="lightbox">
          <form method="dialog">
            <button class="close" type="submit" aria-label="Close">✕</button>
          </form>
          <img src={withBase(src)} width="1920" height="1080" alt={`${gameTitle} screenshot ${i + 1}, full size`} />
        </dialog>
      </>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-dialog-target]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.getAttribute("data-dialog-target");
      const dialog = id ? document.getElementById(id) : null;
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
    });
  });
</script>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-sm);
  }

  .thumb {
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    background: none;
    cursor: zoom-in;
    aspect-ratio: 16 / 9;
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lightbox {
    border: none;
    background: transparent;
    max-width: 92vw;
    max-height: 92vh;
    padding: 0;
  }

  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.85);
  }

  .lightbox img {
    max-width: 92vw;
    max-height: 88vh;
    border-radius: var(--radius);
  }

  .lightbox .close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    background: var(--color-bg);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    width: 2rem;
    height: 2rem;
    cursor: pointer;
  }
</style>
