---
import { getCollection, render } from "astro:content";
import GameLayout from "../../layouts/GameLayout.astro";
import GameShowcase from "../../components/GameShowcase.astro";

export async function getStaticPaths() {
  const games = await getCollection("games");
  return games.map((game) => ({
    params: { slug: game.data.slug },
    props: { game },
  }));
}

const { game } = Astro.props;
const { Content } = await render(game);
---

<GameLayout title={game.data.title} description={game.data.shortDescription}>
  <GameShowcase game={game.data}>
    <Content slot="body" />
  </GameShowcase>
</GameLayout>
